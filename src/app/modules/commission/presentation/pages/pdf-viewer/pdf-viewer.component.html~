<!-- pdf-viewer.component.html -->
<div class="pdf-dialog-container">
    <div class="pdf-header">
        <div class="pdf-title">
            <mat-icon>description</mat-icon>
            <h2>restaurants</h2>
        </div>
        <div class="pdf-actions">
            <button mat-icon-button matTooltip="Close" (click)="close()">
                <mat-icon>close</mat-icon>
            </button>
        </div>
    </div>

    <mat-divider></mat-divider>

    <div class="pdf-toolbar">


        <div class="toolbar-section">
            <button mat-icon-button matTooltip="Zoom out" >
                <mat-icon>zoom_out</mat-icon>
            </button>
            <button mat-icon-button matTooltip="Zoom in">
                <mat-icon>zoom_in</mat-icon>
            </button>
        </div>


    </div>

    <div class="pdf-content-wrapper">

        <div class="pdf-container">
            <iframe [src]="sanitizedUrl" frameborder="0" ></iframe>
        </div>
    </div>
</div>
