import { Injectable } from '@angular/core';
import { BehaviorSubject, Observable, tap } from 'rxjs';
import { HttpClient, HttpHeaders } from '@angular/common/http';
import { environment } from '../../../../../environments/environment';

@Injectable({
  providedIn: 'root'
})
export class RapportService {

    private _data: BehaviorSubject<any> = new BehaviorSubject(null);
    private _totalRevenue: BehaviorSubject<any> = new BehaviorSubject(null);
    private _commissionRevenue: BehaviorSubject<any> = new BehaviorSubject(null);
    private _averageCommissionRate: BehaviorSubject<any> = new BehaviorSubject(null);

    constructor(private _httpClient: HttpClient)
    {
    }
    get totalAverageCommissionRate$(): Observable<any>
    {
        return this._averageCommissionRate.asObservable();
    }
    get totalRevenue$(): Observable<any>
    {
        return this._totalRevenue.asObservable();
    }
    get totalCommissionRevenue$(): Observable<any>
    {
        return this._commissionRevenue.asObservable();
    }
    get data$(): Observable<any>
    {
        return this._data.asObservable();
    }
    getData(): Observable<any>
    {
        return this._httpClient.get(`${environment.apiRestaurantUrl}get-all-restaurants-summarize`).pipe(
            tap((response: any) =>
            {
                this._data.next(response);
            }),
        );
    }


    exportToPdf(): Observable<Blob> {

        return this._httpClient.get<Blob>(`${environment.apiRestaurantUrl}export/pdf`, {
            responseType: 'blob' as 'json',
            headers: new HttpHeaders().set('Accept', 'application/pdf')
        });
    }

    exportToPdfByRestaurantId(restaurantId: string): Observable<Blob> {





        return this._httpClient.get<Blob>(`${environment.apiOrderUrl}restaurant/${restaurantId}`, {
            responseType: 'blob' as 'json',
            headers: new HttpHeaders().set('Accept', 'application/pdf')
        });
    }

    getTotalRevenue(): Observable<number> {
        return this._httpClient.get<number>(`${environment.apiOrderUrl}all-restaurants/total-revenue`).pipe(
            tap((response: any) =>
            {
                this._totalRevenue.next(response);
            }),
        );
    }

    /**
     * Get total commission revenue from all restaurants
     */
    getTotalCommissionRevenue(): Observable<number> {
        return this._httpClient.get<number>(`${environment.apiOrderUrl}all-restaurants/total-commission-revenue`).pipe(
            tap((response: any) =>
            {
                this._commissionRevenue.next(response);
            }),
        );
    }

    /**
     * Get monthly commission revenue: { "2024-01": 5400.0, "2024-02": 6700.0, ... }
     */
    getMonthlyCommissionRevenue(): Observable<Record<string, number>> {
        return this._httpClient.get<Record<string, number>>(
            `${environment.apiOrderUrl}all-restaurants/monthly-commission-revenue`
        );
    }
    getAverageCommissionRate(): Observable<number> {
        return this._httpClient.get<number>(
            `${environment.apiRestaurantUrl}average-commission-rate`
        ).pipe(
            tap((response: any) =>
            {
                this._averageCommissionRate.next(response);
            }),
        );
    }

}
